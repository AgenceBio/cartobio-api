{
  "include": [
    "server.d.ts",
    "*.ts",
    "*.js",
    "lib/**/*.js",
    "lib/**/*.ts",
    "lib/types.d.ts",
    "migrations/**/*.js",
    "migrations/**/*.ts"
  ],
  "exclude": ["**/*.test.js"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "target": "es2020",
    "outDir": "./dist",
    "rootDir": "./",
    "module": "commonjs",
    "lib": ["es2023"],
    "skipLibCheck": true
  }
}