{
  "name": "@agencebio/cartobio-api",
  "version": "3.7.0",
  "description": "api for cartobio",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "dist/src/server.js",
  "private": true,
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cli-progress": "3.11.6",
    "@types/convict": "6.1.6",
    "@types/geojson": "7946.0.16",
    "@types/jsonstream-next": "3.0.3",
    "@types/node": "26.5.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/validator": "13.15.10",
    "@vitest/coverage-v8": "5.0.2",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "5.0.2"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:types && tsc -p tsconfig.build.json",
    "build:types": "npm run build -w @agencebio/cartobio-types",
    "build:geo-data": "node dist/bin/build-geo-data.js",
    "prestart": "npm run build:geo-data && npm run db:migrate:legacy",
    "start": "node dist/src/server.js",
    "predev": "tsx --conditions=source bin/build-geo-data.ts && npm run db:migrate:legacy",
    "dev": "tsx watch --conditions=source src/server.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/cartobio-types/tsconfig.json --noEmit",
    "pretest": "tsx --conditions=source bin/build-geo-data.ts",
    "test": "NODE_ENV=test vitest run --coverage",
    "posttest": "npm run lint && npm run typecheck",
    "test:watch": "NODE_ENV=test vitest",
    "db:generate": "drizzle-kit generate --name",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "tsx --conditions=source bin/reset-db.ts",
    "db:migrate:legacy": "db-migrate up --migrations-dir database/old_migrations",
    "db:migrate:data": "tsx --conditions=source bin/migrate-legacy-data.ts",
    "cron:import": "node dist/bin/cron-import.js",
    "cron:mail-certif": "node dist/bin/cron-mail-certif.js",
    "cron:mail-hebdo": "node dist/bin/cron-mail-hebdo.js",
    "cron:clean-records": "node dist/bin/clean-records.js",
    "cron:clean-pdf": "node dist/bin/delete-pdf.js",
    "job:import-pac": "node dist/bin/import-pac.js",
    "job:import-pac-correctif": "node dist/bin/import-pac-correctif.js",
    "job:parcellaire-pac-oc": "node dist/bin/create-parcellaire-import-pac-for-oc.js",
    "job:parcellaire-xlsx": "node dist/bin/create-parcellaire-import-xlsx.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entrepreneur-interet-general/CartoBio-API.git"
  },
  "keywords": [
    "cartobio",
    "nodejs",
    "api"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AgenceBio/cartobio-api/issues"
  },
  "homepage": "https://github.com/AgenceBio/cartobio-api#readme",
  "dependencies": {
    "@agencebio/cartobio-types": "*",
    "@agencebio/rosetta-cultures": "2.7.0",
    "@fastify/cors": "11.3.0",
    "@fastify/error": "4.2.0",
    "@fastify/formbody": "9.0.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/oauth2": "8.3.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@turf/bbox-polygon": "7.4.0",
    "@turf/boolean-intersects": "7.4.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@turf/union": "7.4.0",
    "adm-zip": "0.6.1",
    "cli-progress": "3.12.0",
    "convict": "6.2.5",
    "db-migrate": "0.11.14",
    "db-migrate-pg": "1.5.2",
    "deepmerge": "4.3.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "fast-jwt": "6.3.3",
    "fast-xml-parser": "5.11.1",
    "fastify": "5.12.4",
    "fastify-plugin": "5.1.0",
    "fastify-type-provider-zod": "7.0.0",
    "file-type": "16.5.4",
    "gdal-async": "3.12.3",
    "get-stream": "6.0.1",
    "got": "11.8.6",
    "jsonstream-next": "3.0.0",
    "mnemonist": "0.40.4",
    "nodemailer": "9.1.1",
    "p-memoize": "4.0.4",
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "pino": "10.3.0",
    "puppeteer": "24.43.1",
    "reproject": "1.2.7",
    "socks-proxy-agent": "8.0.5",
    "strip-bom-stream": "4.0.0",
    "validator": "13.15.35",
    "wkt": "0.1.1",
    "xlsx": "0.18.5",
    "zod": "4.6.5"
  }
}
